# Local runs only. Copy to `.env` and fill in; `.env` is gitignored.
# In GitHub Actions the same names are repository secrets.

# --- LSEG (required) ---
# A service account with access to the LSEG hosted MCP endpoint (scope "lfa").
# LSEG_CLIENT_ID=
# LSEG_CLIENT_SECRET=

# --- Report email (optional) ---
# Without these the report is still built under data/reports/.
# For Gmail use an app password (https://myaccount.google.com/apppasswords).
# SMTP_USER=you@example.com
# SMTP_APP_PASSWORD=
# SMTP_TO=pm@example.com                # comma-separated for several recipients
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# --- Regime froth score (optional) ---
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Without it the froth score runs on fewer inputs.
# FRED_API_KEY=
