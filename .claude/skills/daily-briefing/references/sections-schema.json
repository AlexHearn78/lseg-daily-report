{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "daily-briefing/sections-schema/1.0",
  "title": "sections.json written by the daily-briefing skill",
  "description": "Word limits are enforced by scripts/check_sections.py (JSON Schema cannot count words). top_stories must match pack.top_stories in count and order; earnings_watch and closest_to_changing likewise.",
  "type": "object",
  "additionalProperties": false,
  "required": ["headline", "market_macro", "top_stories", "earnings_watch", "closest_to_changing"],
  "properties": {
    "headline": {"type": "string", "minLength": 10, "maxLength": 240,
                 "description": "One sentence, at most 20 words."},
    "market_macro": {"type": "string", "minLength": 200, "maxLength": 1600,
                     "description": "Two paragraphs separated by one blank line; 120-180 words in total."},
    "top_stories": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "title", "body", "sources"],
        "properties": {
          "ticker": {"type": "string", "pattern": "^[A-Z0-9.]{1,12}$"},
          "title": {"type": "string", "minLength": 3, "maxLength": 120,
                    "description": "At most 8 words; names the cause, not the price."},
          "body": {"type": "string", "minLength": 400, "maxLength": 1400,
                   "description": "One paragraph, 120-180 words: move, cause (dated and attributed), meaning and the model's view, what to watch."},
          "sources": {
            "type": "array", "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "date", "headline"],
              "properties": {
                "source": {"type": "string", "minLength": 2, "maxLength": 40},
                "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
                "headline": {"type": "string", "minLength": 5, "maxLength": 200}
              }
            }
          }
        }
      }
    },
    "earnings_watch": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "title", "body"],
        "properties": {
          "ticker": {"type": "string", "pattern": "^[A-Z0-9.]{1,12}$"},
          "title": {"type": "string", "maxLength": 120},
          "body": {"type": "string", "minLength": 20, "maxLength": 500,
                   "description": "One or two sentences."}
        }
      }
    },
    "closest_to_changing": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "title", "body"],
        "properties": {
          "ticker": {"type": "string", "pattern": "^[A-Z0-9.]{1,12}$"},
          "title": {"type": "string", "maxLength": 120},
          "body": {"type": "string", "minLength": 20, "maxLength": 300,
                   "description": "One sentence."}
        }
      }
    }
  }
}
